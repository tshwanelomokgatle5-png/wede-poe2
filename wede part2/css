/* =========================================
   FRESH BAKES BAKERY - PART 2 CSS
   ========================================= */

/* ---------- CSS RESET ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


/* ---------- GENERAL PAGE STYLING ---------- */

html {
    font-size: 100%;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    padding: 0;
    background-color: #FAF0E6;
    color: #3E2723;
}


/* ---------- HEADER ---------- */

header {
    background-color: #5C4033;
    color: #FFFFFF;
    padding: 2rem 1rem;
    text-align: center;
}

header h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
}

header p {
    font-size: 1rem;
}


/* ---------- NAVIGATION ---------- */

nav {
    background-color: #8B5A2B;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
}

nav a {
    color: #FFFFFF;
    text-decoration: none;
    margin: 0 0.75rem;
    padding: 0.5rem 0.75rem;
    font-weight: bold;
    border-radius: 0.25rem;
    transition: background-color 0.3s ease, color 0.3s ease;
}


/* Hover state */

nav a:hover {
    background-color: #5C4033;
    color: #FFFDD0;
}


/* Focus state */

nav a:focus {
    outline: 0.15rem solid #FFFDD0;
    outline-offset: 0.15rem;
}


/* Active state */

nav a:active {
    background-color: #3E2723;
    color: #FFFFFF;
}


/* ---------- MAIN CONTENT ---------- */

main {
    width: 90%;
    max-width: 75rem;
    margin: 2rem auto;
}

.container {
    max-width: 50rem;
    margin: 2rem auto;
    background-color: #FFFFFF;
    padding: 2rem;
    border-radius: 0.5rem;
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.1);
}


/* ---------- HEADINGS ---------- */

h2 {
    color: #5C4033;
    font-size: 1.7rem;
    margin-bottom: 1rem;
}

h3 {
    color: #8B5A2B;
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
}

p {
    margin-bottom: 1rem;
}


/* ---------- ABOUT PAGE SECTIONS ---------- */

main section {
    margin-bottom: 2rem;
}

main section:last-child {
    margin-bottom: 0;
}

ul {
    padding-left: 1.5rem;
}

li {
    margin-bottom: 0.5rem;
}


/* ---------- HOME PAGE / HERO ---------- */

.hero {
    background-color: #FFFFFF;
    padding: 3rem 2rem;
    text-align: center;
    border-radius: 0.75rem;
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.1);
}

.hero h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
}

.hero p {
    max-width: 45rem;
    margin: 0 auto 1rem;
}


/* ---------- BUTTON ---------- */

.btn {
    display: inline-block;
    background-color: #8B5A2B;
    color: #FFFFFF;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    border-radius: 0.4rem;
    margin-top: 1rem;
    font-weight: bold;
    transition: background-color 0.3s ease, transform 0.2s ease;
}


/* Button hover */

.btn:hover {
    background-color: #5C4033;
    transform: translateY(-0.1rem);
}


/* Button focus */

.btn:focus {
    outline: 0.15rem solid #3E2723;
    outline-offset: 0.15rem;
}


/* Button active */

.btn:active {
    background-color: #3E2723;
    transform: translateY(0);
}


/* ---------- PRODUCT GRID ---------- */

.product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
}

.product-card {
    background-color: #FFFFFF;
    padding: 1.5rem;
    border-radius: 0.6rem;
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.1);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product-card:hover {
    transform: translateY(-0.3rem);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
}

.product-card h3 {
    margin-bottom: 0.5rem;
}

.product-card p {
    margin-bottom: 0;
}


/* ---------- IMAGES ---------- */

img {
    max-width: 100%;
    height: auto;
    display: block;
}

.product-card img {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin-bottom: 1rem;
}


/* ---------- ENQUIRY FORM ---------- */

form {
    width: 100%;
}

label {
    display: block;
    margin-top: 1rem;
    margin-bottom: 0.35rem;
    font-weight: bold;
}

input,
select,
textarea {
    width: 100%;
    padding: 0.75rem;
    margin-bottom: 0.5rem;
    border: 0.0625rem solid #CCCCCC;
    border-radius: 0.3rem;
    font-family: Arial, sans-serif;
    font-size: 1rem;
    background-color: #FFFFFF;
}


/* Form focus */

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: #8B5A2B;
    box-shadow: 0 0 0 0.15rem rgba(139, 90, 43, 0.2);
}


/* ---------- FORM BUTTON ---------- */

button {
    background-color: #8B5A2B;
    color: #FFFFFF;
    border: none;
    padding: 0.8rem 1.25rem;
    margin-top: 1rem;
    cursor: pointer;
    width: 100%;
    border-radius: 0.3rem;
    font-size: 1rem;
    font-weight: bold;
    transition: background-color 0.3s ease, transform 0.2s ease;
}


/* Button hover */

button:hover {
    background-color: #5C4033;
    transform: translateY(-0.1rem);
}


/* Button focus */

button:focus {
    outline: 0.15rem solid #3E2723;
    outline-offset: 0.15rem;
}


/* Button active */

button:active {
    background-color: #3E2723;
    transform: translateY(0);
}


/* ---------- FOOTER ---------- */

footer {
    background-color: #5C4033;
    color: #FFFFFF;
    text-align: center;
    padding: 1rem;
    margin-top: 2rem;
}

footer p {
    margin-bottom: 0;
}


/* =========================================
   TABLET RESPONSIVENESS
   ========================================= */

@media (max-width: 48rem) {

    header {
        padding: 1.5rem 1rem;
    }

    header h1 {
        font-size: 1.7rem;
    }

    nav {
        gap: 0.25rem;
    }

    nav a {
        margin: 0 0.35rem;
        padding: 0.45rem 0.6rem;
    }

    main {
        width: 92%;
    }

    .container {
        padding: 1.5rem;
    }

    .hero {
        padding: 2rem 1.5rem;
    }

    .product-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}


/* =========================================
   MOBILE RESPONSIVENESS
   ========================================= */

@media (max-width: 30rem) {

    body {
        font-size: 0.95rem;
    }

    header {
        padding: 1.25rem 0.75rem;
    }

    header h1 {
        font-size: 1.5rem;
    }

    header p {
        font-size: 0.9rem;
    }

    nav {
        flex-direction: column;
        padding: 0.75rem;
    }

    nav a {
        width: 100%;
        text-align: center;
        margin: 0.15rem 0;
    }

    main {
        width: 94%;
        margin: 1rem auto;
    }

    .container {
        padding: 1.25rem;
        margin: 1rem auto;
    }

    .hero {
        padding: 1.5rem 1rem;
    }

    .hero h2 {
        font-size: 1.5rem;
    }

    h2 {
        font-size: 1.4rem;
    }

    h3 {
        font-size: 1.15rem;
    }

    .product-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    input,
    select,
    textarea,
    button {
        font-size: 1rem;
    }

    footer {
        padding: 0.9rem;
    }
}